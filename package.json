{
  "name": "gwn-sheet-stack",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/run.ts build",
    "typecheck": "bun scripts/run.ts typecheck",
    "verify:dist": "bun scripts/verify-dist.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "changeset": "changeset",
    "version": "changeset version",
    "ci:version": "changeset version && bun install --lockfile-only",
    "ci:publish": "bun run build && bun run verify:dist && bun scripts/publish.ts",
    "release": "bun run build && bun run verify:dist && bun scripts/publish.ts",
    "storybook": "bun run --cwd packages/storybook dev",
    "storybook:build": "bun run --cwd packages/storybook build",
    "postinstall": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@sveltejs/package": "^2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "bun-types": "^1.3.13",
    "eslint": "^10.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.6",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "publint": "^0.3.0",
    "tsup": "^8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "devalue": "^5.8.1"
  }
}
