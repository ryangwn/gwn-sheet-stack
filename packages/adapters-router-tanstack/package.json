{
  "name": "gwn-sheet-stack-adapters-router-tanstack",
  "version": "0.0.0",
  "description": "TanStack Router adapter for sheet-stack.",
  "keywords": [
    "sheet",
    "modal",
    "tanstack",
    "router",
    "sheet-stack"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ryangwn/gwn-sheet-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangwn/gwn-sheet-stack.git",
    "directory": "packages/adapters-router-tanstack"
  },
  "bugs": {
    "url": "https://github.com/ryangwn/gwn-sheet-stack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @tanstack/react-router --external gwn-sheet-stack-core",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests (requires TanStack Router env)'"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1",
    "gwn-sheet-stack-core": "workspace:*"
  },
  "devDependencies": {
    "gwn-sheet-stack-core": "workspace:*"
  }
}
