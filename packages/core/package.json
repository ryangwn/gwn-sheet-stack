{
  "name": "@gwn-sheet-stack/core",
  "version": "0.0.4",
  "description": "Framework-agnostic core for sheet-stack: gesture, spring, FSM, presentation, and event primitives for stacked sheet/modal UIs.",
  "keywords": [
    "sheet",
    "modal",
    "stack",
    "gesture",
    "spring",
    "animation",
    "fsm"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ryangwn/gwn-sheet-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangwn/gwn-sheet-stack.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ryangwn/gwn-sheet-stack/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
